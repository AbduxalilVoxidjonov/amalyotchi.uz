# Backend manzili. Dev'da bo'sh qoldiring — Vite `/api` ni http://127.0.0.1:5080 ga proxy qiladi.
# Docker/prod'da ham bo'sh: client relative `/api` ishlatadi, nginx (dashboard/nginx.conf) uni `api:8080` ga proxy qiladi.
# Faqat API boshqa domenda bo'lsa to'ldiring: https://api.amaliyotchi.uz (oxirida `/` yo'q) — bunda CORS va
# nginx CSP `connect-src` ni ham shu domenga ochish kerak. Docker'da build-arg orqali beriladi (--build-arg VITE_API_URL=...).
VITE_API_URL=

# Vite dev proxy nishoni (faqat dev). Default: http://127.0.0.1:5080
VITE_DEV_API_TARGET=http://127.0.0.1:5080

# true → MSW ishga tushadi, /api/auth/* so'rovlari mock bilan javob beradi (backend shart emas).
# Docker build'da hech qachon berilmaydi (false).
VITE_USE_MOCKS=false

# Talaba ilovasi (TWA) manzili — talabaga parol berilganda "Kirish: <URL>" qatori va login sahifasidagi
# "Talabalar uchun alohida ilova" havolasi shu yerdan olinadi. Bo'sh bo'lsa ko'rsatilmaydi.
# Masalan: https://app.amaliyotchi.uz
VITE_TWA_URL=
