{
  "name": "@amaliyotchi/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dashboard va TWA uchun umumiy: API client, ApiError, JWT parse, auth store fabrikasi, dizayn tokenlari va bazaviy UI kit. TS manba sifatida iste'mol qilinadi (build shart emas).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api/index.ts",
    "./auth": "./src/auth/index.ts",
    "./ui": "./src/ui/index.ts",
    "./styles/tokens.css": "./src/styles/tokens.css"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "build": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "~4.0.18",
    "@types/react": "^19.3.0",
    "react": "^19.3.0"
  },
  "dependencies": {
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}
