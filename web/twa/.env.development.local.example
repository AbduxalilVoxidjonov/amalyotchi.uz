# Nusxa: cp .env.development.local.example .env.development.local  (gitignore'da; faqat `vite dev` o'qiydi)
# Backend: http://127.0.0.10:5080 (vite `/api` proxy). Mock o'chiq — real API.
VITE_USE_MOCKS=false
VITE_DEV_API_TARGET=http://127.0.0.10:5080

# Telegram tashqarisida (oddiy brauzerda) kirish uchun imzolangan initData.
# Generatsiya (bot tokeni dev: 1234567890:DEV-TEST-TOKEN-amaliyotchi, auth_date — hozir, 24 soat amal qiladi):
#   node scratchpad/twa-initdata.mjs 100000001      # demo talabalar: 100000001..100000006
# Muqobil: URL orqali  http://127.0.0.10:5174/?initData=<shu satr>  (query ustunroq). Faqat DEV rejimida ishlaydi.
VITE_DEV_INIT_DATA=auth_date=1789407393&query_id=AAHdF6IQAAAAAN0XohDhrOrc&user=%7B%22id%22%3A100000001%2C%22first_name%22%3A%22Akmal%22%2C%22last_name%22%3A%22Aliyev%22%2C%22username%22%3A%22akmal_dev%22%2C%22language_code%22%3A%22uz%22%7D&hash=REPLACE_WITH_GENERATED
