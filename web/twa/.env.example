# Backend manzili. Dev'da bo'sh — Vite `/api` ni http://127.0.0.10:5080 ga proxy qiladi.
# Docker/prod'da ham bo'sh: client relative `/api` ishlatadi, nginx (twa/nginx.conf) uni `api:8080` ga proxy qiladi.
# Faqat API boshqa domenda bo'lsa to'ldiring (CORS + nginx CSP `connect-src` kerak). Docker'da: --build-arg VITE_API_URL=...
VITE_API_URL=
VITE_DEV_API_TARGET=http://127.0.0.10:5080
# true → MSW (POST /api/auth/telegram mock). Telegram tashqarisida (oddiy brauzerda) test qilish uchun. Docker build'da berilmaydi.
VITE_USE_MOCKS=false
# Faqat dev: Telegram tashqarisida kirish uchun imzolangan initData — qarang .env.development.local.example
VITE_DEV_INIT_DATA=
