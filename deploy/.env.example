# deploy/.env namunasi — nusxalang: cp deploy/.env.example deploy/.env
# Compose shu papkadagi .env ni avtomatik o'qiydi (git'ga qo'shilmaydi).

# JWT imzo kaliti — MAJBURIY, kamida 32 belgi. Generatsiya:
#   openssl rand -base64 48
JWT_SIGNING_KEY=

# PostgreSQL paroli (postgres konteyneri va API ulanish satri uchun bir xil)
POSTGRES_PASSWORD=amaliyotchi

# Telegram bot tokeni (BotFather). Bo'sh bo'lsa API ishlaydi, lekin /api/auth/telegram 403 qaytaradi.
TELEGRAM_BOT_TOKEN=

# Demo ma'lumot (fakultet, guruhlar, tyutor, 38 talaba, davomat...) — FAQAT demo/stend uchun.
# Production: false
SEED_DEMO=true

# Birinchi admin (baza bo'sh bo'lganda bir marta yaratiladi). Production'da albatta o'zgartiring.
# HEMIS ID — login identifikatori (faqat raqamlar, odatda 12 xonali).
ADMIN_HEMIS_ID=100000000001
ADMIN_PASSWORD=admin12345

# Compose tarmog'i subneti — API ForwardedHeaders:KnownNetworks ham shu (nginx proksi ishonchli manba).
# Hostda band bo'lsa boshqa 172.16.0.0/12 diapazonini tanlang.
DOCKER_SUBNET=172.30.0.0/16

# Host portlari (konteyner ichidagi portlar o'zgarmaydi). Hostda band bo'lsa shu yerda almashtiring.
DASHBOARD_PORT=8090
TWA_PORT=8091
API_PORT=5080

# Ixtiyoriy
# RATE_LIMIT_AUTH_PER_MINUTE=10
# RATE_LIMIT_REFRESH_PER_MINUTE=60
# CORS_ORIGIN=http://localhost:5173
