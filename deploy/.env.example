# deploy/.env namunasi (PRODUCTION). Nusxalang va to'ldiring:
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
# Compose shu papkadagi .env ni avtomatik o'qiydi (git'ga qo'shilmaydi). Tekshiruv: deploy/scripts/preflight.sh
#
# Qoidalar:
#  - Qiymatlarni qo'shtirnoqsiz yozing. `$` belgisidan qoching (compose uni o'zgaruvchi deb o'qiydi) —
#    shuning uchun parollar `openssl rand -hex` bilan generatsiya qilinadi.
#  - POSTGRES_PASSWORD da `;` bo'lmasin (API ulanish satriga qo'yiladi).
#  - [MAJBURIY] — bo'sh bo'lsa `docker compose` aniq xato bilan to'xtaydi.

# ===================== Sirlar =====================

# [MAJBURIY] JWT imzo kaliti, kamida 32 belgi. Almashtirilsa barcha sessiyalar bekor bo'ladi.
#   openssl rand -base64 48
JWT_SIGNING_KEY=

# [MAJBURIY] PostgreSQL paroli (postgres, API va backup uchun bir xil).
# Faqat postgres volume BIRINCHI marta yaratilganda qo'llanadi — keyin o'zgartirish README'da.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# [MAJBURIY] Birinchi admin — baza bo'sh bo'lganda BIR MARTA yaratiladi; keyin parol dashboard → Sozlamalar orqali.
# HEMIS ID — login identifikatori (faqat raqamlar, odatda 12 xonali).
ADMIN_HEMIS_ID=
#   openssl rand -base64 18
ADMIN_PASSWORD=

# [MAJBURIY] Seq 'admin' foydalanuvchisi paroli (seq-data volume birinchi yaratilganda).
#   openssl rand -hex 16
SEQ_ADMIN_PASSWORD=

# [MAJBURIY] Cloudflare Tunnel tokeni: Zero Trust → Networks → Tunnels → (tunnel) → Configure →
# "Install connector" dagi `--token` dan keyingi qiymat.
CLOUDFLARE_TUNNEL_TOKEN=

# Telegram bot tokeni (BotFather). Bo'sh bo'lsa API ishlaydi, lekin /api/auth/telegram 403 va bot o'chiq.
# MAJBURIY (compose tekshiradi): Production'da token yo'q bo'lsa API ishga tushmaydi.
TELEGRAM_BOT_TOKEN=

# ===================== Ommaviy manzillar =====================

# [MAJBURIY] HTTPS, oxirida `/` siz. CORS, Telegram Menu Button va dashboard build'i (VITE_TWA_URL) shundan oladi.
# TWA_PUBLIC_URL o'zgarsa dashboard qayta build qilinishi kerak: up -d --build dashboard
DASHBOARD_PUBLIC_URL=https://amalyotchi.uz
TWA_PUBLIC_URL=https://app.amalyotchi.uz

# ===================== Ixtiyoriy =====================

# Bot long polling. Bir vaqtda faqat BITTA instansiya (lokal dev'da shu token bilan bot yoqilmasin).
# TELEGRAM_BOT_ENABLED=true

# Demo ma'lumot — production'da HECH QACHON true qilmang (default false; dev override'da true).
# SEED_DEMO=false

# Compose tarmog'i subneti. Hostda band bo'lsa 172.16.0.0/12 ichidan boshqasi — quyidagi uchala qat'iy IP ham
# shu subnet ichida bo'lishi shart (preflight.sh tekshiradi).
# DOCKER_SUBNET=172.30.0.0/16
# cloudflared konteynerining qat'iy IP si — nginx CF-Connecting-IP ga faqat shu manzildan ishonadi.
# CLOUDFLARED_IP=172.30.0.250
# dashboard/twa nginx konteynerlarining qat'iy IP lari — API X-Forwarded-For ga faqat shulardan ishonadi
# (ForwardedHeaders:KnownProxies).
# DASHBOARD_IP=172.30.0.248
# TWA_IP=172.30.0.249

# Seq UI host porti (faqat 127.0.0.1 ga bog'lanadi; ssh -L 5341:127.0.0.1:5341 user@server).
# SEQ_PORT=5341

# Rate limit (daqiqasiga, IP bo'yicha)
# API qabul qiladigan Host'lar (';' bilan; localhost — healthcheck uchun shart). Bo'sh → '*'.
API_ALLOWED_HOSTS=amalyotchi.uz;app.amalyotchi.uz;localhost

# Kampus bitta NAT IP ortida bo'lsa oshiring (masalan 30).
# RATE_LIMIT_AUTH_PER_MINUTE=10
# RATE_LIMIT_REFRESH_PER_MINUTE=60

# --- Zaxira (backup servisi) ---
# Hostdagi papka (nisbiy yo'l deploy/ ga nisbatan). Serverda alohida diskka/papkaga qo'yish tavsiya etiladi.
# BACKUP_DIR=./backups
# Kunlik zaxira vaqti (UTC, HH:MM). 21:00 UTC = 02:00 Toshkent.
# BACKUP_TIME_UTC=21:00
# Necha kunlik zaxira saqlanadi.
# BACKUP_RETENTION_DAYS=14

# --- Docker log rotatsiyasi (har konteyner uchun: max-size × max-file) ---
# LOG_MAX_SIZE=10m
# LOG_MAX_FILE=5

# --- Xotira chegaralari (2 GB RAM VPS uchun POSTGRES/API/SEQ ni 512m ga tushiring) ---
# POSTGRES_MEM_LIMIT=1g
# API_MEM_LIMIT=1g
# SEQ_MEM_LIMIT=1g
# WEB_MEM_LIMIT=128m
# CLOUDFLARED_MEM_LIMIT=256m
# BACKUP_MEM_LIMIT=512m

# --- PostgreSQL tuning (shared_buffers ≈ POSTGRES_MEM_LIMIT/4) ---
# PG_SHARED_BUFFERS=256MB
# PG_EFFECTIVE_CACHE_SIZE=768MB
# PG_WORK_MEM=8MB
# PG_MAINTENANCE_WORK_MEM=64MB
# PG_MAX_CONNECTIONS=100
# PG_SHM_SIZE=256m
# PG_LOG_MIN_DURATION_MS=2000

# --- Faqat lokal demo (docker-compose.dev.yml) host portlari ---
# DASHBOARD_PORT=8090
# TWA_PORT=8091
# API_PORT=5080
# POSTGRES_PORT=55432
# CORS_ORIGIN=http://127.0.0.1:5173
